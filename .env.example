# ==============================================================================
# 🚀 MarketFlow Pro — Configuração de Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores antes de iniciar o servidor
# ==============================================================================

# --- Servidor HTTP & WebSockets ---
PORT=4000
NODE_ENV=production

# --- Segurança Enterprise & Criptografia ---
# JWT Secret para autenticação de administradores e clientes
JWT_SECRET=seu_jwt_secret_forte_e_seguro_aqui_2026

# Chave mestra AES-256 para criptografia reversível das API Keys/Secrets da Bybit
MASTER_ENCRYPTION_KEY=sua_chave_mestra_aes256_32_bytes_aqui

# Credenciais do Administrador Master (criado automaticamente no primeiro boot)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=defina_uma_senha_forte_unica
ADMIN_NAME=Administrador MarketFlow

# E-mail transacional (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=seguranca@uebamix.com.br
EMAIL_FROM_NAME=MarketFlow Pro

# Configuração de CORS (Opcional - URLs permitidas separadas por vírgula)
# ALLOWED_ORIGINS=https://seu-dominio.up.railway.app

# --- Base de Dados (PostgreSQL / Railway) ---
DATABASE_URL=postgresql://postgres:senha@host:porta/railway

# --- Provedores de Inteligência Artificial & Quant Advisor ---
# Opções de AI_PROVIDER: 'nexus' (padrão OpenAI Tool Calling via Cérebro) ou 'gemini'
AI_PROVIDER=nexus

# Endpoint e chave do Nexus Cérebro (OpenAI Compatible)
NEXUS_BASE_URL=https://nexus-cerebro-production-a7c0.up.railway.app/v1
NEXUS_CEREBRO_URL=https://nexus-cerebro-production-a7c0.up.railway.app/v1
NEXUS_API_KEY=sua_chave_nexus_aqui

# Chave Google Gemini (Google AI Studio - Gemini 3.7 Flash)
GEMINI_API_KEY=sua_chave_gemini_aqui

# --- Hub Central de Comunicação (Alertas de Trades via WhatsApp) ---
COMUNICACAO_API_URL=https://comunicacao-hub-production.up.railway.app/api
API_SECRET_KEY=defina_um_segredo_de_integracao_unico

# --- Laya upstream original (Sistema 1) ---
# Preferir o proxy privado Railway; nenhum segredo Laya é distribuído ao Mercado.
MARKET_LAYA_NATIVE_URL=http://nexus-decisor-laya.railway.internal:8001
MARKET_LAYA_PRIVATE_PROXY=true
MARKET_LAYA_SHADOW_ENABLED=true
MARKET_LAYA_TIMEOUT_MS=4000
MARKET_LAYA_MIN_CONFIDENCE=0.85
MARKET_LAYA_MAX_CONCURRENT_CLIENT=2
MARKET_LAYA_BUSY_RETRY_MS=1000
MARKET_LAYA_POSITION_INTERVAL_MS=10000
MARKET_LAYA_TACTICAL_MODE=SHADOW
# Somente para endpoint público: MARKET_LAYA_AUTH_TOKEN / MARKET_LAYA_API_KEY.
# No proxy privado Railway, o bearer é injetado pelo proxy.

# --- Railway Infrastructure (Deploy e Gestão de Serviços) ---
RAILWAY_PROJECT_ID=
RAILWAY_TOKEN=
RAILWAY_API_KEY=
